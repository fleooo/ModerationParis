{% extends "base.html.twig" %}

{% block title %}Détails de {{ product.name }}{% endblock %}

{% block body %}
<main class="container">
    <section class="row mt-5">
        <div class="col-6 text-center">
            {% if product.images|length > 0 %}
                {% set image = product.images[0] %}
                <img src="{{ asset('asset/uploads/products/') ~ image.name }}" class="w-75 rounded-3" alt="{{ product.name }}">
            {% endif %}
        </div>
        <div class="col-6">
            <h2>{{ product.name }}</h2>
            <p class="text-muted">{{ product.categories.name }}</p>
            <p>{{ product.description }}</p>
            {% if product.stock > 0 %}
                <div class='abtn'>
                    <p class="text-success">Produit en stock</p>
                </div>
                {% else %}
                <p class="text-danger">Temporairement en rupture de stock</p>
                {% endif %}
            <h5>{{ product.price / 100 }}€</h5>

            <hr class="mt-5">
            
            <div class="input-group mt-5 mb-3" style="max-width: 120px; display: flex; align-items: center;">
                <button id="decrement-btn" class="btn btn-white" type="button">-</button>
                <input id="quantity-input" class="nbrProd text-center" value="1" min="1" style="width: 50px;">
                <button id="increment-btn" class="btn btn-pink" type="button">+</button>
            </div>
            <a id="buy-now-link" href="#" class="btn btn-pink btn-lg mt-4">Buy Now</a>
            <!-- Button to add to cart without redirecting -->
            <button id="add-to-cart" data-product-id="{{ product.id }}" class="btn btn-pink btn-lg mt-4 ms-3">+</button>

            <!-- Original Buy Now button with dynamic quantity -->
            
        </div>
    </section>
</main>

<style>
    .btn-pink {
        background-color: #ff66b2;
        color: white;
    }
    .btn-white {
        background-color: #ffff;
        color: black;
       border: solid 1px black;
    }
    .btn-pink:hover {
        background-color: #ff3385;
    }
    .btn-white:hover {
        background-color: #9f9f9f;
    }
    .input-group {
        display: flex;
        align-items: center;
    }
    .form-control {
        text-align: center;
    }
    .nbrProd{
        padding-top:6%;
        padding-bottom:6%;
        border: none;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var quantityInput = document.getElementById('quantity-input');
        var incrementBtn = document.getElementById('increment-btn');
        var decrementBtn = document.getElementById('decrement-btn');
        var addToCartBtn = document.getElementById('add-to-cart');
        var buyNowLink = document.getElementById('buy-now-link');

        // Increment quantity
        incrementBtn.addEventListener('click', function() {
            quantityInput.value = parseInt(quantityInput.value) + 1;
            updateBuyNowLink();
        });

        // Decrement quantity
        decrementBtn.addEventListener('click', function() {
            if (parseInt(quantityInput.value) > 1) {
                quantityInput.value = parseInt(quantityInput.value) - 1;
                updateBuyNowLink();
            }
        });

        // Add to cart without redirecting
        addToCartBtn.addEventListener('click', function() {
            var productId = this.getAttribute('data-product-id');
            var quantity = parseInt(quantityInput.value);

            fetch('{{ path('cart_add_ajax') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({ id: productId, quantity: quantity })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Produit ajouté au panier !');
                } else {
                    alert('Erreur lors de l\'ajout au panier.');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                alert('Erreur lors de l\'ajout au panier.');
            });
        });

        // Update the "Buy Now" link with the correct quantity
        function updateBuyNowLink() {
            var quantity = parseInt(quantityInput.value);
            buyNowLink.href = "{{ path('cart_add_ajax') }}?id={{ product.id }}&quantity=" + quantity + "&redirect=true";
        }

        // Initialize "Buy Now" link on page load
        updateBuyNowLink();

        // Redirect to checkout after clicking "Buy Now"
        buyNowLink.addEventListener('click', function(e) {
            e.preventDefault();
            var productId = "{{ product.id }}";
            var quantity = parseInt(quantityInput.value);

            fetch('{{ path('cart_add_ajax') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify({ id: productId, quantity: quantity })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = "{{ path('cart_index') }}";
                } else {
                    alert('Erreur lors de l\'ajout au panier.');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                alert('Erreur lors de l\'ajout au panier.');
            });
        });
    });
</script>
{% endblock %}