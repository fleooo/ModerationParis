{% extends 'base.html.twig' %}


{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container">
    <form method="post" class="form">
        <h1 class="title">Me connecter</h1>

        {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
        <div class="alert alert-success">
            Vous êtes connecté(e) comme {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Me
                déconnecter</a>
        </div>
        {% endif %}

        <div class="input-group">
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="input"
                autocomplete="email" required autofocus placeholder=" ">
            <span>Email</span>
        </div>

        <div class="input-group">
            <input type="password" name="password" id="inputPassword" class="input"
                autocomplete="current-password" required placeholder=" ">
            <span>Mot de passe</span>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="confirmBtn">
            <button class="submit" type="submit">Me connecter</button>
        </div>
        <p class="signin mt-2">Vous n'avez pas de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a></p>
        <p class="signin mt-2"><a href="{{ path('forgotten_password') }}">Mot de passe oublié ?</a></p>
    </form>
</div>

<style>
.container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    min-height: 80vh;
}

.form {
    display: flex;
    flex-direction: column;
    gap: 25px;
    padding: 2em;
    background-color: #1E2A6A;
    border-radius: 25px;
    max-width: 450px;
    width: 100%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    transition: transform 0.4s ease-in-out;
    margin: 0 auto;
    color: #fff;
    border: 1px solid #333;
}

.form:hover {
    transform: scale(1.05);
}

.title {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #F9EFEF;
    position: relative;
    text-align: center;
}

.title::before, 
.title::after {
    content: '';
    position: absolute;
    height: 18px;
    width: 18px;
    border-radius: 50%;
    background-color: #FF88DC;
    margin-top: 2.5%;
    left: 15%
}

.title::after {
    animation: pulse 1.5s linear infinite;
}

@keyframes pulse {
    from {
        transform: scale(0.9);
        opacity: 1;
    }
    to {
        transform: scale(1.8);
        opacity: 0;
    }
}

.input-group {
        position: relative;
        margin-bottom: 20px;
        width: 100%;
    }

    .input-group .input {
        background-color: #F9EFEF;
        color: #000;
        width: 100%;
        padding: 20px 10px 10px;
        border: 1px solid #FF88DC;
        border-radius: 8px !important;  /* Bord arrondi forcé */
        outline: 0;
        transition: border-color 0.3s ease;
    }

    .input-group .input:focus {
        border-color: #f821b7;
    }

    .input-group .input + span {
        color: #2176FF;
        position: absolute;
        left: 12px;
        top: 8px;
        font-size: 0.9em;
        cursor: text;
        transition: top 0.3s ease, font-size 0.3s ease;
    }

    .input-group .input:placeholder-shown + span {
        top: 20px;
        font-size: 1em;
    }

    .input-group .input:focus + span,
    .input-group .input:valid + span {
        top: 8px;
        font-size: 0.8em;
        font-weight: 600;
    }

.confirmBtn {
    display: flex;
    justify-content: center;
    margin-top: 1.5em;
}

.submit {
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    background-color: #FF88DC;
    color: white;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    font-size: 1em;
}

.submit:hover {
    background-color: #f821b7;
    transform: translateY(-2px);
}

.signin {
    text-align: center;
    font-size: 1em;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 1em;
}

.signin a {
    color: #FF88DC;
    text-decoration: none;
    transition: color 0.3s ease, text-decoration 0.3s ease;
}

.signin a:hover {
    color: #f821b7;
    text-decoration: underline;
}
</style>
{% endblock %}