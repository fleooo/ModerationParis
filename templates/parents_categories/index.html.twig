{% extends 'base.html.twig' %}

{% block body %}
<main>
    <div class="big">
        <h2 class="pt-2 pb-2 
            {% if parentCategory.name == 'Avec Moderations' %}
                back-yellow
            {% elseif parentCategory.name == 'Sans Moderations' %}
                back-blue
            {% endif %}
        ">
            {{ parentCategory.name }}
        </h2>
    </div>
    <section class="row">

        {% for category in categories %}
        <div class="col-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title">{{ category.name }}</h3>
                    <a href="{{ path('categories_list', {slug: category.slug}) }}" class="catName">{{ category.name }}</a>
                </div>
            </div>
        </div>
        {% endfor %}
    </section>
</main>
<style>
    .big {
        background-color: #F7B538;
        color: white;
        text-align: center;
        text-transform: uppercase;
    }
    .catName{
        text-decoration: none;  
    }
    .back-blue {
        background-color: #2176FF;
    }
    .back-yellow {
        background-color: #F7B538;
    }
</style>
{% endblock %}