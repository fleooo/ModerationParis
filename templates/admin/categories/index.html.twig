{% extends "base.html.twig" %}

{% block title %}Liste des Catégories{% endblock %}

{% block body %}
    <div class="container">
        <div class="row">
            {% include "_partials/_adminnav.html.twig" %}
            <main class="col-9 border border-light bg-white p-2">
                <h1>Liste des Catégories</h1>
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Parent</th>
                            <th>Slug</th>
                            <th>Ordre</th>
                            <th>Images</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr>
                                <td>{{ category.id }}</td>
                                <td>{{ category.name }}</td>
                                <td>{{ category.parent ? category.parent.name : 'None' }}</td>
                                <td>{{ category.slug }}</td>
                                <td>{{ category.categoryOrder }}</td>
                                <td>
                                    {% for image in category.categoryImages %}
                                        <img src="{{ asset('uploads/categories/' ~ image.name) }}" alt="{{ image.name }}" style="width: 50px; height: auto;" />
                                    {% else %}
                                        No images
                                    {% endfor %}
                                </td>
                                <td>
                                    <a href="{{ path('admin_categories_edit', {'id': category.id}) }}" class="btn btn-primary">Edit</a>
                                    <a href="{{ path('admin_categories_delete', {'id': category.id}) }}" class="btn btn-danger">Delete</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </main>
        </div>
    </div>
{% endblock %}