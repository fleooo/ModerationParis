<body>
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container-fluid">
            <a class="logo" href="{{ path('app_main') }}">
                <img src="img/logoModerations.png" alt="Logo" class='logoM'>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo01" aria-controls="navbarTogglerDemo01" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                <div class="wrap">
                    <!-- Formulaire de recherche -->
                    <form class="search" action="{{ path('search_results') }}" method="get">
                        <input type="text" name="query" class="searchTerm rounded-5" placeholder="Rechercher ...">
                        <button type="submit" class="searchButton">
                            <!-- SVG icon de loupe en noir -->
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="#000000">
                                <path d="M10 2a8 8 0 0 1 8 8 8 8 0 0 1-1.34 4.42l4.44 4.44a1 1 0 0 1-1.42 1.42l-4.44-4.44A8 8 0 1 1 10 2m0 2a6 6 0 1 0 6 6 6 6 0 0 0-6-6z"/>
                            </svg>
                        </button>
                    </form>
                </div>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('cart_index') }}">Panier</a>
                    </li>
                    {% if app.user %}
                        {% if is_granted('ROLE_PRODUCT_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_index') }}">Administration</a>
                            </li>
                        {% endif %}
                        <li class="nav-item">
                            <a class="nav-link log rounded-5" href="{{ path('user_profile') }}">Profil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link log rounded-5 ms-2" href="{{ path('app_logout') }}">Déconnexion</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link log rounded-5 ms-2" href="{{ path('app_register') }}">Inscription</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link log rounded-5 ms-2" href="{{ path('app_login') }}">Connexion</a>
                        </li>
                    {% endif %}
                </ul>

                <div class="language-selector ms-3">
                    <select id="language-select" class="form-select">
                        <option value="en">English</option>
                        <option value="fr">Français</option>
                    </select>
                </div>
            </div>
        </div>
    </nav>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>    
</body>

</html>

<style>
.logoM{
    background:none;
    width:60%
}
.search {
  width: 100%;
  position: relative;
  display: flex;
}

.searchTerm {
  width: 100%;
  border: none;
  padding: 5px 40px 5px 10px;
  height: 36px;
  outline: none;
  color: black;
  border-radius: 5px;
}

.searchTerm:focus{
  color: black;
}

.searchButton {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40px;
  height: 36px;
  border: none;
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.searchButton svg {
  fill: #000000; /* SVG en noir */
}

.searchButton:hover svg {
  fill: black;
}

.wrap {
  width: 15%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
nav{
    background-color: #1E2A6A;
}
.log{
    background-color: white;
}

.log:hover {
  background-color: #fff;
  animation: button-particles 1s ease-in-out infinite;
  transform: translateY(-2px);
}

.log:active {
  transform: scale(0.95);
  box-shadow: 0 2px 10px;
}


</style>